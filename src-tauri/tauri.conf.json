{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMWAPOS",
  "version": "0.1.0",
  "identifier": "com.amwapos.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AMWAPOS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AMWAPOS",
    "copyright": "AMWAPOS",
    "category": "Business",
    "shortDescription": "Offline-first retail POS",
    "longDescription": "AMWAPOS — offline-first retail POS and retail operations platform.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
